{
  "name": "freelance-web-studio",
  "version": "1.0.0",
  "description": "Full-Stack Freelance Web Design and Development Services Platform",
  "private": true,
  "scripts": {
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client && npm run build:server",
    "seed": "npm --prefix server run seed",
    "test": "npm run build:server && node --test tests/unit.cjs tests/integration.cjs tests/zoho.test.cjs tests/serverless.test.cjs tests/acceptance_10.test.cjs",
    "test:integration": "npm run build:server && node --test tests/integration.cjs",
    "test:zoho": "npm run build:server && node --test tests/zoho.test.cjs",
    "test:browser": "npm run build && playwright test",
    "db:check": "npm --prefix server run db:check"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10"
  }
}
