PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Zoho CRM India Data Center Integration (OAuth 2.0)
# Create a Server-based Application in Zoho Developer Console (https://api-console.zoho.in)
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho/callback
# Generated after one-time authorization at /api/zoho/auth or provided from Zoho Developer Console
ZOHO_REFRESH_TOKEN=
# Endpoints for Zoho India Data Center (.in)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/crm/v8

# JWT Secret & Expiration (Must be at least 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Default Initial Administrator Credentials
DEFAULT_ADMIN_EMAIL=admin@tejastudio.com
DEFAULT_ADMIN_PASSWORD=replace_with_a_private_password_at_least_12_chars
DEFAULT_ADMIN_NAME="Studio Admin"

# Email Configuration (Nodemailer SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Teja Web Studio <hello@tejastudio.com>"
ADMIN_NOTIFICATION_EMAIL=admin@tejastudio.com
EMAIL_SERVICE_ENABLED=false

# Server-side website chat assistant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
